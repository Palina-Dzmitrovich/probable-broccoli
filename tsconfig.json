{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    
    "types": ["k6", "@playwright/test"],
    
    "outDir": "./dist",
    "noEmit": true
  },
  "include": [
    "src/**/*.ts", 
    "perf/**/*.ts"
  ]
}